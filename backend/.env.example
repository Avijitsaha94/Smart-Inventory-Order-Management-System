# Server Configuration
PORT=5000

# Database
# For local MongoDB
MONGO_URI=mongodb://localhost:27017/smart-inventory

# For MongoDB Atlas (Cloud)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/smart-inventory?retryWrites=true&w=majority

# JWT Secret (Change this to a strong random string in production)
JWT_SECRET=your_super_secret_key_change_this_in_production

# Environment
NODE_ENV=development